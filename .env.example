# ==============================================================================
# 1. BACKEND SERVICE (Spring Boot API)
# ==============================================================================
APP_PORT=8000
SPRING_PROFILES_ACTIVE=prod

# ==============================================================================
# 2. DATABASE SERVICE (PostgreSQL)
# ==============================================================================
DATABASE_URL=postgresql://your_db_user:your_db_password@your-db-host.com:5432/soopi_shop

# Local Dev Docker only: Cấu hình khởi tạo container postgres trong docker-compose.dev.yml
POSTGRES_DB=soopi_shop
POSTGRES_USER=soopi_user
POSTGRES_PASSWORD=soopi_dev_password_change_me
POSTGRES_PORT=5433

# ==============================================================================
# 3. CACHE SERVICE (Redis)
# ==============================================================================
# Cấu hình kết nối Redis cho backend (Hỗ trợ Local Redis hoặc Cloud như Upstash, Redis Cloud)
SPRING_DATA_REDIS_HOST=your-redis-host.com
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=your_redis_password
SPRING_DATA_REDIS_SSL_ENABLED=false

# Local Dev Docker only: Cổng ánh xạ container redis trong docker-compose.dev.yml
REDIS_PORT=6379

# ==============================================================================
# 4. AUTH & SECURITY SERVICE (Clerk OAuth2)
# ==============================================================================
# JWKS endpoint để xác thực JWT token của người dùng từ Clerk
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
