# ==============================================================================
# 1. BACKEND SERVICE (Spring Boot API)
# ==============================================================================
SERVER_PORT=8000

# ==============================================================================
# 2. DATABASE SERVICE (PostgreSQL 16 - Local Docker hoặc Neon Cloud Free-tier)
# ==============================================================================
POSTGRES_HOST=postgres
POSTGRES_DB=soopi_shop
POSTGRES_PORT=5432
POSTGRES_USER=soopi_user
POSTGRES_PASSWORD=soopi_dev_password_change_me

# Mặc định cho Docker Compose local (đổi 'postgres:5432' thành 'localhost:5433' nếu chạy mvnw trực tiếp trên máy host)
DATABASE_URL=postgresql://soopi_user:soopi_dev_password_change_me@postgres:5432/soopi_shop

# --- Tùy chọn Cloud Free-tier: Neon Serverless PostgreSQL 16 ---
# Dán trực tiếp Connection String từ Neon Console (SSL & channel_binding được tự động chuẩn hóa cho pgJDBC):
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
# (Khuyến nghị cho Flyway khi dùng Pooled endpoint ở trên: trỏ trực tiếp sang Direct endpoint không có '-pooler')
# FLYWAY_DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
# (Tối ưu Neon scale-to-zero Free-tier: đặt 0 để không giữ kết nối nhàn rỗi)
# DB_POOL_MIN_IDLE=0
# DB_POOL_MAX_SIZE=10

# ==============================================================================
# 3. CACHE SERVICE (Redis)
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# 4. AUTH & SECURITY SERVICE (Clerk OAuth2)
# ==============================================================================
CLERK_ISSUER_URI=
CLERK_SECRET_KEY=your-clerk-secret-key
